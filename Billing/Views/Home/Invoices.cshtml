
@{
    ViewData["Title"] = "Invoices";
}
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Invoices</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

<!-- Main content -->
<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">

                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Invoices</h3>
                    </div>
                    <!-- /.card-header -->
                    <div class="card-body">
                        <table id="InvoicesTable" class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>Invoice No</th>

                                    <th>Sales ID</th>
                                    <th>Amount</th>
                                    <th>Paid</th>
                                    <th>Balance</th>
                                    <th>Status</th>
                                    <th>Created Date</th>
                                    <th>Action</th>
                                </tr>

                            </thead>
                            <tbody>


                        </table>
                    </div>
                    <!-- /.card-body -->
                </div>
                <!-- /.card -->
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->
    </div>
    <!-- /.container-fluid -->
</section>
<!-- /.content -->
<div class="modal fade" id="ClientModel">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 id="mtitle" class="modal-title"></h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div id="mbody" class="modal-body">

            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-default" data-dismiss="modal">Close</button>
            </div>
        </div>
        <!-- /.modal-content -->
    </div>
    <!-- /.modal-dialog -->
</div>
<script>
    function LoadData() {
        $("#InvoicesTable").DataTable({
            // Design Assets
            stateSave: true,
            autoWidth: true,
            destroy: true,
            // ServerSide Setups
            processing: true,
            serverSide: true,
            // Paging Setups
            paging: true,
            // Searching Setups
            searching: { regex: true },
            // Ajax Filter
            ajax: {
                url: "/ViewDataServer/LoadInvoicesTables",
                type: "POST",
                contentType: "application/json",
                dataType: "json",
                data: function (d) {
                    return JSON.stringify(d);
                }
            },
            // Columns Setups
            columns: [
                { data: "invid" },
                { data: "sid" },
                { data: "amt" },
                { data: "paid" },
                { data: "balance" },
                {
                    data: "status",
                    render: function (data, type, row) {
                        if (data === "Paid") {
                            return '<span class="btn btn-success">' + data + '</span>';
                        }
                        else {
                            return '<span class="btn btn-danger">' + data + '</span>';
                        }
                    }
                },

                {
                    data: "cdate",
                    render: function (data, type, row) {
                        // If display or filter data is requested, format the date
                        if (type === "display" || type === "filter") {
                            return moment(data).format("ddd DD/MM/YYYY HH:mm:ss");
                        }
                        // Otherwise the data type requested (`type`) is type detection or
                        // sorting data, for which we want to use the raw date value, so just return
                        // that, unaltered
                        return data;
                    }
                },
                {
                    data: null,
                    render: function (data, type, row) {
                        if (row.status === "Paid") {
                            return '<a class="btn btn-default" onclick="PrintInv(\'' + row.id + '\');" title="Print">Print</a>';

                        }
                        else {
                            return '<a href="#" class="btn btn-primary" onclick="PayInvoices(\'' + row.id + '\');">Pay</a>  <a class="btn btn-default" onclick="PrintInv(\'' + row.id + '\');" title="Print">Print</a>';

                        }
                    }
                }
            ],
            // Column Definitions
            columnDefs: [
                { targets: "no-sort", orderable: false },
                { targets: "no-search", searchable: false },
                {
                    targets: "trim",
                    render: function (data, type, full, meta) {
                        if (type === "display") {
                            data = strtrunc(data, 10);
                        }

                        return data;
                    }
                },
                { targets: "date-type", type: "date-eu" }
            ]
        });
    }
    $(document).ready(function () {
        LoadData();
    });
    function PrintInv(id) {

        var mywindow = window.open("/Home/bill/" + id, 'Print', 'height=900,width=900');


        setTimeout(function () {
            mywindow.focus();
            mywindow.print();
            //mywindow.close();
        }, 5000);



        return true;
    }
    function PayInvoices(id) {
        $("#mbody").load("/Home/PopUpModalShow/PayInvoices-" + id, function () {

            $("#mtitle").text("Pay Invoice");
            $("#ClientModel").modal("show");
        });
    }
    function strtrunc(str, num) {
        if (str.length > num) {
            return str.slice(0, num) + "...";
        }
        else {
            return str;
        }
    }
</script>

