@{
    Layout = null;
    var i = 0;
}
@model Billing.Models.bill
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- Google Font: Source Sans Pro -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700&display=fallback">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="~/plugins/fontawesome-free/css/all.min.css">
    <!-- Theme style -->
    <link rel="stylesheet" href="~/dist/css/adminlte.min.css">
    <!-- jQuery -->
    <script src="~/plugins/jquery/jquery.min.js"></script>
    <!-- Bootstrap 4 -->
    <script src="~/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
    <!-- AdminLTE App -->
    <script src="~/dist/js/adminlte.min.js"></script>
    <!-- AdminLTE for demo purposes -->
    <script src="~/dist/js/demo.js"></script>
    <style type="text/css">
        .h-divider {
            margin-top: 5px;
            margin-bottom: 5px;
            height: 1px;
            width: 100%;
            border-top: 1px solid gray;
        }
    </style>
</head>
<body>

    <!-- Main content -->
    <div class="invoice p-3 mb-3">
        <!-- title row -->
        <div class="row">
            <div class="col-12">
                <h4>
                    <i class="fas fa-globe"></i> @Model.prof.name
                    <small class="float-right">Date: @Model.inv.cdate.ToString("dd/MM/yyyy")</small>
                </h4>
            </div>
            <!-- /.col -->
        </div>
        <!-- info row -->
        <div class="row invoice-info">
            <div class="col-md-12">
                <table class="table table-striped">
                    <tr style="width:100%;">
                        <th >
                            <div class="col-md-4 invoice-col">
                                From
                                <address>
                                    <strong> @Model.prof.name</strong><br>
                                    @Model.prof.address<br />
                                    Phone: @Model.prof.phone<br>
                                    Email: @Model.prof.email<br />
                                    GST:@Model.prof.gst
                                </address>
                            </div>
                        </th>
                        <th>
                            <div class="col-md-4 invoice-col">
                                To
                                <address>

                                    @if (Model.clt != null)
                                    {
                                        <strong>@Model.clt.name</strong><br>
                                        @Model.clt.address <br>
                                        <p>Phone: @Model.clt.phone<br />
                                        Email: @Model.clt.email<br />
                                            GST IN: @if (Model.clt.gst == null)
                                            {
                                                var p = "Not Applicable";@p }
                                            else
                                            { @Model.clt.gst}
                                        </p>
                                    }
                                    else
                                    {
                                        <strong>@Model.sls.clname</strong><br>
                                    }

                                </address>
                            </div>
                        </th>
                        <th>
                            <div class="col-md-4 invoice-col">
                                <b>Invoice #@Model.inv.invid</b><br>
                                <br>
                                <b>Order ID:</b> @Model.inv.sid<br>
                                <b>Payment Due:</b> @Model.inv.cdate.ToString("dd/MM/yyyy")<br>
                               
                            </div>

                        </th>
                    </tr>
                </table>
                   
              
            </div>
           
            <!-- /.col -->
        </div>
        <!-- /.row -->
        <!-- Table row -->
        <div class="row">
            <div class="col-md-12 table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Sno</th>
                            <th>Product</th>
                            <th>Amount</th>
                            <th>QTY</th>
                            <th>Total AMount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.sls.content)
                        {
                            var mrp =Math.Round( (Convert.ToDouble(item.mrp) * 100) / (Convert.ToDouble(item.tax) + 100),2);
                            var totamt =Math.Round( (Convert.ToDouble(mrp)) * Convert.ToDouble(item.qty),2);
                            i++;
                            <tr>
                                <td>@i</td>
                                <td>@item.name</td>
                                <td>@mrp</td>
                                <td>@item.qty</td>
                                <td>@totamt</td>
                            </tr>
                        }

                    </tbody>
                </table>
            </div>
            <!-- /.col -->
        </div>
        <!-- /.row -->

        <div class="row col-md-12">
            <!-- accepted payments column -->
            <div class="col-md-6">

            </div>
            <!-- /.col -->
            <div class="col-md-6">
                <p class="lead">Amount Due @Model.inv.cdate.ToString("dd/MM/yyyy")</p>

                <div class="table-responsive">
                    <table class="table">
                        <tr>
                            <th style="width:50%">Subtotal:</th>
                            <td>
                                @{
                                    var mamt =
                                        Convert.ToDouble(Model.inv.amt) - Convert.ToDouble(Model.sls.taxt);
                                    @mamt;

                                }
                        </td>
                    </tr>
                    <tr>
                        <th>Tax (@Model.sls.content[0].tax %)</th>
                        <td>@Model.sls.taxt</td>
                    </tr>

                    <tr>
                        <th>Total:</th>
                        <td>@Model.inv.amt</td>
                    </tr>
                </table>
            </div>
        </div>
        <!-- /.col -->
    </div>
    <!-- /.row -->
    <!-- this row will not appear when printing -->
    <div class="col-md-12">
        <div class="h-divider">
        </div>
        <div class="text-center">
            <h6>Bank Account Details: </h6>
            <p>Bank Account No : @Model.prof.bankaccno   
            Bank Name : @Model.prof.bankname<br />
            Bank Branch : @Model.prof.bankbranch   Bank IFSC : @Model.prof.ifsc</p>
        </div>
    </div>
</div>
<!-- /.invoice -->
</body>
</html>